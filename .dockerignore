# Build context hygiene. node_modules is rebuilt in the image; public/ is build output.
node_modules
public
.quartz-cache
.git
.turbo
prof
tsconfig.tsbuildinfo

# Never let local note content into the build context. The vault is bind-mounted at run
# time; anything here would be baked into a PUBLIC image layer.
content/*
!content/.gitkeep
private/
.obsidian
